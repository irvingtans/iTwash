/build/*
!/build/sites-vite-plugin.ts
!/build/sites-vite-plugin.LICENSE
*.tsbuildinfo
next-env.d.ts

# Test reports, caches, and temporary files
coverage/
.nyc_output/
playwright-report/
test-results/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
/tmp/
/temp/
*.tmp
*.temp
*.swp
*.swo
*~

# Logs and OS metadata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# Local credentials; only the blank template is committed
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key

